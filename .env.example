# ===========================================================================
# Automation Tool — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Env.
# Values below marked (fallback) have a hardcoded default in the ported code
# carried over verbatim from n8n — set the env var to override.
# ===========================================================================

# --- Security --------------------------------------------------------------
# Random string. Vercel Cron sends it automatically as a Bearer token; manual
# triggers (POST /api/workflows/<id>/run) must send it too.
#   openssl rand -hex 32
CRON_SECRET=

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only — NEVER expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # dashboard read-only via RLS
SUPABASE_STORAGE_BUCKET=automation-assets

# --- OpenAI (carousels, captions, briefs; gpt-image-1 + gpt-5-mini) --------
OPENAI_API_KEY=

# --- Google Gemini (The Ember Wolf episode generator) ----------------------
GEMINI_API_KEY=

# --- Meta Graph API (all Instagram/Facebook publishing + reports) ----------
GRAPH_API_VERSION=v23.0
# Long-lived token with instagram_content_publish + pages_read_engagement etc.
IG_ACCESS_TOKEN=

# Per-brand IG Business Account IDs (code falls back to the verbatim values).
IG_TIXUY_BUSINESS_ACCOUNT_ID=17841472867696210
IG_COCOGROVE_BUSINESS_ACCOUNT_ID=17841461430625142      # (fallback)
IG_NIANOVA_BUSINESS_ACCOUNT_ID=17841423897325080        # (fallback)
IG_SORRELPIP_BUSINESS_ACCOUNT_ID=                       # username guard: sorrelandpip
IG_ESSIBY_BUSINESS_ACCOUNT_ID=
IG_SHARED_BUSINESS_ACCOUNT_ID=17841472867696210         # (fallback) perf report + tracker

# Facebook Page IDs (reel cross-posting / page-token resolution).
FB_NIANOVA_PAGE_ID=1244182618788962                     # (fallback)

# --- Cloudinary (image re-upload hop before IG; branded-slide typesetting) --
# NOTE: the Tixuy Auto-Post "Build Branded Slide" step hardcodes cloud e38kpvav,
# so CLOUDINARY_CLOUD_NAME must be e38kpvav for that workflow to brand slides.
CLOUDINARY_CLOUD_NAME=e38kpvav
CLOUDINARY_UPLOAD_PRESET=n9o5mzxk
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Square (CocoGrove Daily Sales Report) ---------------------------------
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=                 # required — n8n had a placeholder here

# --- Google Sheets (reports + competitor tracker log rows) -----------------
# Full service-account JSON as a single-line string. Share each target sheet
# with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
COCOGROVE_IG_PERF_SHEET_ID=135uhPSNzAPZxY8lq3iu3T4dwXb0JXgXYs76pL-aQNaE   # (fallback)
SHARED_IG_PERF_SHEET_ID=1UncVWdnVD-IVdhFVk4GSuWe684oaSJOeY--PV3bJOwQ      # (fallback)
IG_COMPETITOR_SHEET_ID=1DmRXcKs4t-joRgscgDVMjTtI8LsjmD1DCaoAW81djAQ       # (fallback)
# Comma-separated usernames the competitor tracker pulls via Business Discovery.
IG_COMPETITOR_USERNAMES=tahir.dsgn, growfast.co.id, 360influencemedia, digitalmarketingagency.online

# --- Email reports (Resend) ------------------------------------------------
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@yourdomain.com
# Default recipient. Individual workflows fall back to their original n8n
# recipients (shibile504@gmail.com for CocoGrove, partywear475@gmail.com for
# Tixuy/essiby/shared) when this is unset.
REPORT_TO_EMAIL=
